# ──────────────────────────────────────────────────────────────────
# CoverSwap — variables d'environnement (Vercel)
# Copier en .env.local pour le développement ; aucune valeur ici.
# ──────────────────────────────────────────────────────────────────

# CRM (obligatoire) : réception des demandes
CRM_WEBHOOK_URL=""
CRM_WEBHOOK_SECRET=""

# Simulateur : génération sur le CRM (Railway, travail asynchrone suivi par le navigateur) ; secret partagé
NEXT_PUBLIC_SIMULATE_URL="https://crm.coverswap.fr/api/simulate"
SIMULATE_TOKEN_SECRET=""
# Plus aucune génération sur Vercel depuis la mission 15 : OPENAI_API_KEY et OPENAI_IMAGE_MODEL
# ne servent qu'au CRM (Railway) — à retirer des variables Vercel.

# Mail de secours si le CRM est injoignable (Resend, domaine vérifié)
RESEND_API_KEY=""
LEAD_FALLBACK_EMAIL="contact@coverswap.fr"
LEAD_FALLBACK_FROM="CoverSwap Alert <noreply@coverswap.fr>"

# Captcha Cloudflare Turnstile (inactif tant que vide)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# Mesure : plus aucun outil tiers depuis la mission 16 (partie 6). NEXT_PUBLIC_GTM_ID, NEXT_PUBLIC_GA_ID,
# NEXT_PUBLIC_META_PIXEL_ID et NEXT_PUBLIC_CLARITY_ID ne sont plus lues : à retirer des variables Vercel.
# NEXT_PUBLIC_SANS_EVENEMENTS=1 coupe l'envoi des événements au CRM (intégration continue seulement, jamais sur Vercel).

# Cron de vérification du webhook
CRON_SECRET=""

# Adresse publique
NEXT_PUBLIC_SITE_URL="https://coverswap.fr"

# Limites indicatives du simulateur côté site (la vraie limite est côté CRM)
# SIMULATION_DAILY_LIMIT_PER_IP=15
# SIMULATION_DAILY_LIMIT_GLOBAL=150
